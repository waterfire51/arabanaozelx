generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  iconPath  String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  shortDescription String?
  description      String?
  imagePath        String
  price            Decimal          @db.Decimal(10, 2)
  compareAtPrice   Decimal?         @db.Decimal(10, 2)
  badge            String?
  active           Boolean          @default(true)
  featured         Boolean          @default(true)
  customizable     Boolean          @default(true)
  sortOrder        Int              @default(0)
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  orderItems       OrderItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label         String
  quantity      Int      @default(1)
  unitPrice     Decimal  @db.Decimal(10, 2)
  shipmentPrice Decimal  @db.Decimal(10, 2) @default(0)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HeroSlide {
  id        String   @id @default(cuid())
  title     String?
  subtitle  String?
  imagePath String
  href      String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Anasayfa slider altındaki tanıtım videosu (tek kayıt)
model HomeVideo {
  id        String   @id @default("default")
  videoPath String
  href      String?
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Page {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  body            String     @db.Text
  status          PageStatus @default(PUBLISHED)
  sortOrder       Int        @default(0)
  metaTitle       String?
  metaDescription String?    @db.Text
  metaKeywords    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// Site geneli: logo, favicon, varsayılan SEO (tek kayıt)
model SiteSettings {
  id                  String   @id @default("default")
  siteName            String   @default("Arabana Özel")
  defaultMetaTitle    String   @default("Arabana Özel | Kişiye Özel Oto Aksesuar")
  defaultMetaDescription String @default("Kişiye özel oto plakalık, anahtarlık, araç içi aksesuar ve sipariş yönetimi.") @db.Text
  defaultMetaKeywords String?
  titleTemplate       String   @default("%s | Arabana Özel")
  logoPath            String   @default("")
  faviconPath         String   @default("")
  ogImagePath         String?
  contactPhone        String?
  contactEmail        String?
  contactWhatsapp     String?
  updatedAt           DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  imagePath String
  caption   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model BlogPost {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  excerpt         String?    @db.Text
  body            String     @db.Text
  coverImagePath  String?
  status          PageStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?    @db.Text
  metaKeywords    String?
  ogImagePath     String?
  author          String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, publishedAt])
}

model Order {
  id                String          @id @default(cuid())
  orderNo           String          @unique
  paytrMerchantOid  String?         @unique
  customerFirstName String
  customerLastName  String
  customerEmail     String?
  phone             String
  city              String
  district          String
  address           String          @db.Text
  status            OrderStatus     @default(NEW)
  paymentMethod     PaymentMethod   @default(COD)
  paymentStatus     PaymentStatus   @default(PAID)
  subtotal          Decimal         @db.Decimal(10, 2)
  shipmentTotal     Decimal         @db.Decimal(10, 2) @default(0)
  total             Decimal         @db.Decimal(10, 2)
  note              String?         @db.Text
  items             OrderItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  variantLabel String
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)
  design       Json
}

enum OrderStatus {
  NEW
  CONFIRMED
  PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  PAYTR
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

model IconCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  coverPath String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  icons     Icon[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Icon {
  id         String      @id @default(cuid())
  name       String
  filePath   String   @unique
  mimeType   String?
  source     IconSource  @default(ADMIN)
  active     Boolean     @default(true)
  sortOrder  Int         @default(0)
  categoryId String?
  category   IconCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

enum IconSource {
  ADMIN
  CUSTOMER
}
