# Prisma Postgres: Console → Connect → uygulama URL (migrate / prisma_migration URL DEĞİL)
# Vercel: aynı değeri Production + Preview Environment Variables'a ekleyin
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arabana_ozel?schema=public"
ADMIN_PASSWORD="admin123"

# Canlı site (SEO, PayTR dönüş, sipariş takip linkleri, sitemap)
NEXT_PUBLIC_SITE_URL="https://www.arabanaozel.com"

# Google Search Console — HTML etiketindeki content değeri (meta name=google-site-verification)
GOOGLE_SITE_VERIFICATION="LQXbz3kEFpm3-G4fMhyJvl49rI3L5GeCsydGtIn_YEs"

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-9BZ3KK0VBP"

# PayTR (https://www.paytr.com) — Mağaza paneli > Entegrasyon bilgileri
# Bildirim URL: https://www.arabanaozel.com/api/paytr/callback
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
# Test işlemleri için 1, canlı için 0
PAYTR_TEST_MODE="1"

# GitHub assets repo (görseller)
GITHUB_TOKEN=""
GITHUB_ASSETS_OWNER="waterfire51"
GITHUB_ASSETS_REPO="arabanaozelx_assets"
NEXT_PUBLIC_ASSETS_BASE_URL="https://raw.githubusercontent.com/waterfire51/arabanaozelx_assets/main"
